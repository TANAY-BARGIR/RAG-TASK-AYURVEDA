# Copy to .env and fill in real values. Never commit the real .env file.

# NVIDIA NIM API key used for embeddings + Llama generation.
NVIDIA_API_KEY=

# Required to enable POST /api/v1/ingredients and /api/v1/formulations.
# Leaving this unset disables writes entirely (fails closed, not open).
ADMIN_API_KEY=

# Comma-separated list of browser origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:3000

# Rate limit applied to POST /api/v1/search (it triggers billed NVIDIA calls).
SEARCH_RATE_LIMIT=20/minute
